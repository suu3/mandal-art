    "@types/react": "^19.0.4", "@types/react-dom": "^19.0.2", "@vitejs/plugin-react": "^6.0.0",
    "miniflare": "latest", "sharp": "^0.35.3", "typescript": "^5.7.2", "vite": "^8.3.4", "vitest": "^4.1.0", "wrangler": "^4.151.1"
  }
