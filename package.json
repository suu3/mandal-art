{
  "name": "mandalart",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply mandalart --local",
    "db:migrate:remote": "wrangler d1 migrations apply mandalart --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src server tests *.ts *.json *.jsonc index.html README.md",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.13",
    "html-to-image": "1.11.13",
    "lucide-react": "0.468.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "miniflare": "5.20261023.2-beta",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  }
}
